# Copy to .env at the repository root. System environment variables take priority.
OPENAI_API_KEY=your-modelscope-token
OPENAI_BASE_URL=https://api-inference.modelscope.cn/v1
OPENAI_MODEL=Qwen/Qwen3.8-Flash-Next
# Optional; default is backend/data/grading.sqlite3.
# DATABASE_PATH=/absolute/path/grading.sqlite3
# Frontend proxy defaults to http://127.0.0.1:8000.
# Set in the frontend process environment or frontend/.env.local.
# BACKEND_URL=http://127.0.0.1:8000
